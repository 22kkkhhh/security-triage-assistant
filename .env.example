# 本地 Demo 数据库（SQLite）。生产部署不可简单沿用。
DATABASE_URL="file:./prisma/dev.db"

# Better Auth（高熵密钥；禁止提交真实 Secret）
# 至少 32 字符随机串；不得使用 "secret" / "123456" 等弱值
BETTER_AUTH_SECRET="replace-with-a-high-entropy-secret-at-least-32-chars"
# Development: http://localhost:3000 ；Production 必须显式配置，禁止依赖 localhost fallback
BETTER_AUTH_URL="http://localhost:3000"

# Development-only Demo 登录口令（≥12 字符）。production seed 不会创建 Demo Users。
# DEMO_AUTH_PASSWORD="DemoPass_ChangeMe_9x!"

# Production / fresh instance：一次性 bootstrap 首个 ADMIN（npm run user:bootstrap-admin）。
# 全部必填；无默认口令；若已存在 enabled ADMIN 则拒绝。
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_DISPLAY_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=
