// Prisma 7 + SQLite（本地 Demo / MVP 专用）
// 数据库 URL 配置于 prisma.config.ts / .env

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// 案件持久化记录：索引字段 + 单一 caseState + 独立 reportDraft
model CaseRecord {
  id         String @id @default(cuid())
  /// 稳定案件编号，如 INC-20260808-001；创建后永不变更
  caseNumber String @unique
  title      String

  /// NEW | INVESTIGATING | PENDING_VERIFICATION | PENDING_BUSINESS_CONFIRMATION | RESPONDING | CLOSED
  status String

  suggestedRiskLevel String?
  humanRiskLevel     String?
  humanConclusion    String?

  username          String?
  sourceIp          String?
  /// 全部涉及系统，以 | 拼接，便于 contains 搜索，例如：HR 系统|ERP 系统|CRM_PROD
  systemsSearchText String?

  pendingChecklistCount Int       @default(0)
  hasReport             Boolean   @default(false)
  /// 报告草稿最后写入时间；仅 saveReportDraft / 首次生成时更新，案件编辑不改动
  reportUpdatedAt       DateTime?

  /// 当前案件可恢复状态（PersistedCaseState JSON）
  caseState   Json
  /// 人工编辑后的报告草稿；null 表示尚未生成报告
  reportDraft Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  /// 最后一次有意义的运营活动时间（成功写入 Audit 时更新；创建时等于 createdAt）
  lastActivityAt DateTime @default(now())

  /// 案件负责人（运营责任，非 ACL）；null = 未分配
  assignedToUserId String?
  assignedAt       DateTime?
  assignedTo       User?     @relation("CaseAssignee", fields: [assignedToUserId], references: [id], onDelete: Restrict)

  /// 操作审计（append-only）；删除策略 Restrict，禁止静默级联删除
  auditLogs CaseAuditLog[]

  @@index([status])
  @@index([updatedAt])
  @@index([lastActivityAt])
  @@index([username])
  @@index([sourceIp])
  @@index([assignedToUserId])
}

/// 案件操作审计日志（与 Timeline 分离：记录研判人员/系统对案件的操作）
model CaseAuditLog {
  id     String     @id @default(cuid())
  caseId String
  case   CaseRecord @relation(fields: [caseId], references: [id], onDelete: Restrict)

  /// AuditActionType（String 存储，Domain 侧 TS union）
  actionType String

  /// AuditActorType：SYSTEM | MANUAL | USER
  actorType String
  /// 登录用户 ID；MANUAL / SYSTEM 为 null；USER 时指向 User.id
  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: Restrict)
  /// 展示名：系统 / 研判人员名 /「未填写研判人员」；MANUAL 非可信认证身份
  actorName String?

  /// 面向 UI 的一句话中文摘要（短）
  summary String

  /// 结构化变化（短字段，禁止整案快照）
  changes  Json?
  /// 可选元数据（如 handoff 原文、export 文件名）
  metadata Json?

  /// 可选：未来显式语义操作去重
  operationId String? @unique

  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
  @@index([actionType])
  @@index([actorId])
}

// ---------------------------------------------------------------------------
// Better Auth identity / session（v1.3 Step 2）
// Schema 对照自：npx auth@1.6.26 generate → scripts/.tmp/better-auth-schema.prisma
// User.role 唯一物理 SoT：ADMIN | ANALYST | VIEWER（与 domain/auth 同名）
// enabled：产品启用状态（server-owned）；banned* 为 Admin Plugin schema 字段，产品不调用
// ---------------------------------------------------------------------------

model User {
  id              String         @id
  name            String
  email           String
  emailVerified   Boolean        @default(false)
  image           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  username        String?
  displayUsername String?
  /// Security Triage UserRole 唯一 SoT：ADMIN | ANALYST | VIEWER
  role            String?
  /// Admin Plugin schema 字段；产品禁用态使用 enabled，不走 ban/unban
  banned          Boolean?       @default(false)
  banReason       String?
  banExpires      DateTime?
  /// 产品账号启用状态；DB NOT NULL + default true；input=false（server-owned）
  enabled         Boolean        @default(true)
  sessions        Session[]
  accounts        Account[]
  caseAuditLogs   CaseAuditLog[]
  assignedCases   CaseRecord[] @relation("CaseAssignee")

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Credential 密码哈希（Better Auth 管理）；禁止业务层 passwordHash
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Security & Compliance Knowledge Center（v1.4 Step 1）
// Domain 枚举以 TypeScript 为 SoT；SQLite 存 String / Json。
// Executable SecurityRule 仍在 TS registry；RuleControlMapping.ruleId 为字符串引用。
// ---------------------------------------------------------------------------

/// 逻辑文档（跨版本稳定身份）
model ComplianceDocument {
  id               String  @id @default(cuid())
  /// 内部稳定编码（非法律文号），如 CN-DSL
  canonicalCode    String  @unique
  title            String
  /// DocumentType
  documentType     String
  jurisdiction     String
  issuingAuthority String
  description      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions ComplianceDocumentVersion[]

  @@index([documentType])
  @@index([title])
}

/// 文档版本（展示 label 与内部 versionKey 分离）
model ComplianceDocumentVersion {
  id         String             @id @default(cuid())
  documentId String
  document   ComplianceDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  /// 内部稳定版本键（非展示文案）
  versionKey     String
  versionLabel   String
  documentNumber String?

  publishDate   DateTime?
  /// 日历日语义：以 UTC 日期部分为准；窗口 [effectiveDate, expiryDate)
  effectiveDate DateTime
  expiryDate    DateTime?

  /// PublicationStatus：知识库工作流
  publicationStatus String
  /// LegalStatus：现实效力（历史选版不因 SUPERSEDED 排除）
  legalStatus       String

  /// KnowledgeSourceType
  sourceType String
  sourceUrl  String?

  /// RightsStatus / ContentMode
  rightsStatus String
  contentMode  String

  sourceFileName String?
  sourceFileHash String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  reviewedAt  DateTime?
  publishedAt DateTime?

  clauses ComplianceClause[]

  @@unique([documentId, versionKey])
  @@index([publicationStatus])
  @@index([legalStatus])
  @@index([effectiveDate])
}

/// 条款（parentClauseId + sortOrder 表达层级）
model ComplianceClause {
  id                String                    @id @default(cuid())
  documentVersionId String
  documentVersion   ComplianceDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  clauseKey     String
  articleNumber String?
  chapter       String?
  section       String?
  heading       String?

  parentClauseId String?
  parentClause   ComplianceClause?  @relation("ClauseHierarchy", fields: [parentClauseId], references: [id], onDelete: Restrict)
  childClauses   ComplianceClause[] @relation("ClauseHierarchy")

  originalText   String?
  summary        String?
  interpretation String?

  /// string[] JSON
  topics Json

  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  controlMappings ControlClauseMapping[]

  @@unique([documentVersionId, clauseKey])
  @@index([documentVersionId, sortOrder])
  @@index([articleNumber])
}

/// 产品内部控制词汇（非法律文件）
model ComplianceControl {
  id          String  @id @default(cuid())
  controlCode String  @unique
  title       String
  /// ComplianceControlDomain
  domain      String
  description String
  objectives  String?

  /// ContextRequirement[] JSON
  requiredContext         Json
  /// EvidenceSuggestion[] JSON
  suggestedEvidence       Json
  /// ChecklistSuggestion[] JSON
  suggestedChecklistItems Json

  /// ComplianceControlStatus：DRAFT | ACTIVE | RETIRED
  status String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ruleMappings   RuleControlMapping[]
  clauseMappings ControlClauseMapping[]

  @@index([domain])
  @@index([status])
}

/// Rule → Control（ruleId 字符串引用 TS registry；无 Prisma FK）
model RuleControlMapping {
  id        String            @id @default(cuid())
  ruleId    String
  controlId String
  control   ComplianceControl @relation(fields: [controlId], references: [id], onDelete: Restrict)

  /// RuleControlRelation：PRIMARY | SUPPORTING
  relation  String
  rationale String?

  /// ContextRequirement[] JSON
  requiredContext Json
  priority        Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ruleId, controlId])
  @@index([ruleId])
  @@index([controlId])
}

/// Control → Clause（静态知识关系；不含 INSUFFICIENT_CONTEXT）
model ControlClauseMapping {
  id        String            @id @default(cuid())
  controlId String
  control   ComplianceControl @relation(fields: [controlId], references: [id], onDelete: Restrict)
  clauseId  String
  clause    ComplianceClause  @relation(fields: [clauseId], references: [id], onDelete: Restrict)

  /// ControlClauseRelation：CONTROL_SUPPORT | POSSIBLE_OBLIGATION | ESCALATION_TRIGGER
  relationType String
  rationale    String

  requiredContext         Json
  suggestedEvidence       Json
  suggestedChecklistItems Json

  /// MappingReviewStatus：DRAFT | REVIEWED | APPROVED
  reviewStatus String
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([controlId, clauseId, relationType])
  @@index([controlId])
  @@index([clauseId])
}
